rules_version = '2';

// Nenhum acesso direto do cliente — toda leitura/escrita passa pela Cloud
// Function (Admin SDK, que ignora estas regras). Isso é deliberado: o
// widget do site nunca fala com o Firestore diretamente, só com o endpoint
// HTTPS da function, que concentra a lógica de escalonamento/curadoria.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
